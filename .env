# === LLM & Embedding Provider (Google Gemini) ===
GOOGLE_API_KEY=AIza...

# === PostgreSQL + pgvector ===
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://acr_user:acr_pass@localhost:5432/acr_db

# === Redis (Celery broker) ===
REDIS_URL=redis://localhost:6379/0

# === GitHub Webhook ===
# Secret set in GitHub repo Settings -> Webhooks
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub Personal Access Token (for posting PR comments)
GITHUB_TOKEN=ghp_...

# === Embedding Model ===
# Options: "gemini" (gemini-embedding-001, 768-dim) [default]
#          "local"  (sentence-transformers, padded to 768-dim)
EMBEDDING_PROVIDER=gemini-embedding-001

# === Application ===
APP_ENV=development
LOG_LEVEL=INFO
