# ==============================================================================
# 🤖 Ambient Code Reviewer - Environment Configuration
# ==============================================================================

# ─── LLM & Embedding Provider (Google Gemini) ─────────────────────────────────
# Get your API key: https://aistudio.google.com/app/apikey
# This key powers both the Gemini 2.0 Flash LLM and the Gemini Embeddings.
GOOGLE_API_KEY=AIza...

# ─── PostgreSQL + pgvector ────────────────────────────────────────────────────
# The project uses pgvector for semantic search of your documentation.
# Format: postgresql://user:password@host:port/dbname
# Inside Docker: use 'db' as host.
DATABASE_URL=postgresql://acr_user:acr_pass@db:5432/acr_db

# ─── Redis (Celery Broker & Result Backend) ───────────────────────────────────
# Used for task queuing and internal communication between API and Workers.
# Inside Docker: use 'redis' as host.
REDIS_URL=redis://redis:6379/0

# ─── GitHub Integration ───────────────────────────────────────────────────────
# 1. GITHUB_WEBHOOK_SECRET: Generate a random string (e.g., 'openssl rand -hex 20').
#    Must match the 'Secret' field in your GitHub Repo -> Settings -> Webhooks.
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# 2. GITHUB_TOKEN: A Personal Access Token (classic) with 'repo' scope.
#    Used to fetch private PR diffs and post review comments.
#    Create here: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...

# ─── Provider & Model Settings ────────────────────────────────────────────────
# EMBEDDING_PROVIDER: 
#   - 'gemini' (default, uses models/gemini-embedding-001, 768-dim)
#   - 'local'  (uses sentence-transformers, padded to 768-dim)
EMBEDDING_PROVIDER=gemini

# ─── Application Settings ─────────────────────────────────────────────────────
# APP_ENV: 'development' or 'production'
APP_ENV=development
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
